# Optional OpenAI-compatible chat model. Without these values the app runs in
# a fully local extractive-answer mode with citations.
RAG_API_KEY=
RAG_BASE_URL=https://api.openai.com/v1
RAG_MODEL=gpt-4.1-mini

# Retrieval and ingestion defaults.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
